  muladd:: p = 0x0000 r0 = 0x1f r1 = 0x00  r01 = 0x001f new_r01 = 0x001f new_r2 = 0x00 new_r1 = 0x00 new_r0 = 0x1f
[i =  1, k =  2]	 left_1 x right_1 (0x1f*0x00)	[r0 = 0x1f, r1 = 0x00, r2 = 0x00]

