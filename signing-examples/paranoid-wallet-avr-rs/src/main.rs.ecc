fn print_hex_arr<S>(tag: &str, serial: &mut S, arr: &[u8])
where
    S: uWrite,
    <S as uWrite>::Error: Debug,
{
    ufmt::uwrite!(serial, "{} = ", tag).unwrap();
    for e in arr {
        if *e < 16 {
            ufmt::uwrite!(serial, "0{:x}", *e).unwrap();
        } else {
            ufmt::uwrite!(serial, "{:x}", *e).unwrap();
        }
    }
    ufmt::uwrite!(serial, "\r\n").unwrap();
}

