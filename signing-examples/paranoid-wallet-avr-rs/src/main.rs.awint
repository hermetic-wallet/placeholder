fn print_hex_arr<S>(tag: &str, serial: &mut S, arr: &[u8])
where
    S: uWrite,
    <S as uWrite>::Error: Debug,
{
    ufmt::uwrite!(serial, "{} = ", tag).unwrap();
    for e in arr {
        if *e < 16 {
            ufmt::uwrite!(serial, "0{:x}", *e).unwrap();
        } else {
            ufmt::uwrite!(serial, "{:x}", *e).unwrap();
        }
    }
    ufmt::uwrite!(serial, "\r\n").unwrap();
}

fn print_hex_str_arr<S>(tag: &str, serial: &mut S, arr: &[u8])
where
    S: uWrite,
    <S as uWrite>::Error: Debug,
{
    ufmt::uwrite!(serial, "{} = ", tag).unwrap();
    //for e in arr {
    //    ufmt::uwrite!(serial, "{}", *e as char).unwrap();
    //}
    for i in 0..128 {
        ufmt::uwrite!(serial, "{}", arr[i] as char).unwrap();
    }
    ufmt::uwrite!(serial, "\r\n").unwrap();
}

#[arduino_hal::entry]
fn main() -> ! {
    let dp = arduino_hal::Peripherals::take().unwrap();
    let pins = arduino_hal::pins!(dp);
    let mut serial = arduino_hal::default_serial!(dp, pins, 57600);

    ufmt::uwriteln!(&mut serial, "Hello from Arduino!\r").void_unwrap();

    let curve = Curve::secp256k1();
    let mut private_key = inlawi!(0x001_u512);

    //let mut buf: [u8; 128] = [0; 128];
    //private_key.to_u8_slice(&mut buf);
    //print_hex_arr("privat-key", &mut serial, &buf);

    //ufmt::uwriteln!(&mut serial, "About to sign\r").void_unwrap();
    let public_key = curve.multiply_simple(&mut private_key);
    //public_key.x.to_u8_slice(&mut buf);
    //print_hex_arr("public-key x:", &mut serial, &buf);
    //public_key.y.to_u8_slice(&mut buf);
    //print_hex_arr("public-key y:", &mut serial, &buf);

    //print_hex_arr("public-key", &mut serial, &buf);
    ufmt::uwriteln!(&mut serial, "Going on loop...!\r").void_unwrap();
    loop {}

    loop {
        // Read a byte from the serial connection
        let b = nb::block!(serial.read()).void_unwrap();

        // Answer
        ufmt::uwriteln!(&mut serial, "Got {}!\r", b).void_unwrap();
    }
}
